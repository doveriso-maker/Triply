  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "code",
          "value": "(?<code>.+)"
        }
      ],
      "destination": "/admin-login.html?code=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/order/",
      "destination": "/order/index.html"
    },
    {
      "source": "/order",
      "destination": "/order/index.html"
    },
    {
      "source": "/order/:code",
      "destination": "/order/index.html"
    },
    {
      "source": "/p/:code",
      "destination": "/preview/?code=:code"
    },
    {
      "source": "/admin",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin-login.html"
    },
    {
      "source": "/app",
