{
  "rewrites": [
    {
      "source": "/trip/:code",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/trip-data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}